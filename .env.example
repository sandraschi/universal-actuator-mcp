# universal-actuator-mcp — environment variables
#
# Copy this file to .env and fill in your values.

# SSE port for the hub (default: 10929, see WEBAPP_PORTS.md + fleet-start.config.ps1)
# UA_SSE_PORT=10929

# Force SSE transport (instead of stdio)
# UA_FORCE_SSE=1

# MCP transport mode
# MCP_TRANSPORT=sse
# MCP_PORT=10929

# Federated node base URL probed by GET /api/fleet/servers (default: local node)
# FLEET_NODE_URL=http://127.0.0.1:10854
